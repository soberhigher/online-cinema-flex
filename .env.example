# === Application ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
API_V1_PREFIX=/api/v1
APP_BASE_URL=http://localhost:8000

# === Database (PostgreSQL only; do not substitute SQLite) ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=cinema
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cinema

# === Redis / Celery ===
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === JWT / tokens ===
# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# The API refuses to start with a weak key unless APP_DEBUG=true.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
ACTIVATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# === Mail (MailHog local) ===
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@cinema.local

# === Stripe (TEST MODE ONLY; placeholder keys) ===
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_SUCCESS_URL=http://localhost:8000/api/v1/payments/success
STRIPE_CANCEL_URL=http://localhost:8000/api/v1/payments/cancel
